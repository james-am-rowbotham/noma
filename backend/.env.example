# Copy to .env to override. Every setting has a local-development default (src/noma/settings.py),
# so a fresh checkout needs no .env at all.

# The local database from docker-compose.yml. Anywhere other than a developer's machine sets this.
NOMA_DATABASE_URL=postgresql+psycopg://noma:noma@localhost:5433/noma

# TypeSafe's Jev (https://typesafe.ai), which turns computed facts into a typed verdict for
# monitors. Get a key from the TypeSafe console. Optional: without it, anything that needs Jev
# fails and says so, and the rest of Noma is unaffected. NOTE the NOMA_ prefix — it is this
# application's, not the vendor's, and an unprefixed JEV_API_KEY is ignored.
NOMA_JEV_API_KEY=
